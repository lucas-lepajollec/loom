[
  {
    "id": "codex",
    "name": "Codex",
    "logo": "codex",
    "docs": "https://github.com/agentclientprotocol/codex-acp",
    "launcher": {
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/codex-acp@2.1.0"
      ],
      "detect": [
        "codex"
      ]
    },
    "inspect": {
      "binary": "codex",
      "version": [
        "codex",
        "--version"
      ],
      "update": [
        "npm",
        "install",
        "-g",
        "@openai/codex@latest"
      ],
      "auth": {
        "cmd": [
          "codex",
          "login",
          "status"
        ],
        "format": "text"
      },
      "mcp": {
        "cmd": [
          "codex",
          "mcp",
          "list",
          "--json"
        ],
        "format": "codex"
      },
      "skills": [
        "~/.codex/skills",
        "~/.agents/skills"
      ],
      "env": [
        "OPENAI_API_KEY",
        "CODEX_API_KEY"
      ],
      "install": {
        "unix": [
          "npm",
          "install",
          "-g",
          "@openai/codex"
        ],
        "windows": [
          "npm",
          "install",
          "-g",
          "@openai/codex"
        ]
      },
      "latest": {
        "npm": "@openai/codex"
      },
      "requires": [
        "npm",
        "node"
      ],
      "source": "https://github.com/openai/codex/blob/main/README.md",
      "native_roots": [
        "~/.codex/packages/standalone/"
      ],
      "repair_paths": [
        "~/.codex/packages/standalone/current/bin/codex",
        "~/.codex/packages/standalone/releases/*/bin/codex",
        "~/.codex/packages/standalone/current/bin/codex.exe",
        "~/.codex/packages/standalone/releases/*/bin/codex.exe"
      ],
      "native_update": [
        "update"
      ],
      "brew_names": [
        "codex"
      ]
    },
    "remote": {
      "order": 3
    }
  },
  {
    "id": "claude-code",
    "name": "Claude Code",
    "logo": "claudecode",
    "docs": "https://github.com/agentclientprotocol/claude-agent-acp",
    "launcher": {
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/claude-agent-acp@0.88.0"
      ],
      "detect": [
        "claude"
      ]
    },
    "inspect": {
      "binary": "claude",
      "version": [
        "claude",
        "--version"
      ],
      "update": [
        "npm",
        "install",
        "-g",
        "@anthropic-ai/claude-code@latest"
      ],
      "auth": {
        "cmd": [
          "claude",
          "auth",
          "status"
        ],
        "format": "json",
        "connected": "loggedIn",
        "method": "authMethod",
        "account": "email"
      },
      "mcp": {
        "cmd": [
          "claude",
          "mcp",
          "list"
        ],
        "format": "claude"
      },
      "plugins": {
        "file": "~/.claude/plugins/installed_plugins.json",
        "format": "claude-plugins"
      },
      "skills": [
        "~/.claude/skills"
      ],
      "env": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN"
      ],
      "install": {
        "unix": [
          "npm",
          "install",
          "-g",
          "@anthropic-ai/claude-code"
        ],
        "windows": [
          "npm",
          "install",
          "-g",
          "@anthropic-ai/claude-code"
        ]
      },
      "latest": {
        "npm": "@anthropic-ai/claude-code"
      },
      "requires": [
        "npm",
        "node"
      ],
      "source": "https://code.claude.com/docs/en/setup",
      "native_roots": [
        "~/.local/share/claude/versions/",
        "~/.claude/local/claude"
      ],
      "repair_paths": [
        "~/.local/share/claude/versions/*"
      ],
      "native_update": [
        "update"
      ],
      "brew_names": [
        "claude-code"
      ]
    },
    "remote": {
      "order": 2
    }
  },
