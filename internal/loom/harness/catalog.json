  {
    "id": "hermes",
    "name": "Hermes",
    "logo": "hermes",
    "docs": "https://hermes-agent.nousresearch.com/docs/",
    "launcher": {
      "command": "hermes",
      "args": [
        "acp"
      ],
      "detect": [
        "hermes"
      ]
    },
    "inspect": {
      "binary": "hermes",
      "version": [
        "hermes",
        "--version"
      ],
      "update": [
        "hermes",
        "update"
      ],
      "install": {
        "unix": [
          "bash",
          "https://hermes-agent.nousresearch.com/install.sh",
          "--non-interactive"
        ],
        "windows": [
          "powershell",
          "-ExecutionPolicy",
          "Bypass",
          "-NoProfile",
          "-NonInteractive",
          "-File",
          "https://hermes-agent.nousresearch.com/install.ps1",
          "-NonInteractive"
        ]
      },
      "requires": [
        "bash"
      ],
      "requires_os": {
        "windows": [
          "powershell"
        ],
        "unix": [
          "bash",
          "curl",
          "git"
        ]
      },
      "source": "https://hermes-agent.nousresearch.com/docs/getting-started/installation",
      "latest": {
        "github": "NousResearch/hermes-agent"
      },
      "native_roots": [
        "~/.hermes/",
        "~/AppData/Local/hermes/"
      ],
      "repair_paths": [
        "~/.hermes/venv/bin/hermes",
        "~/.hermes/bin/hermes",
        "~/AppData/Local/hermes/bin/hermes.exe"
      ],
      "native_update": [
        "update"
      ],
      "brew_names": [
        "hermes-agent"
      ]
    },
    "remote": {
      "order": 1
    }
  },
