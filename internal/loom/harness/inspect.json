{
  "claude-code": {
    "binary": "claude",
    "version": [
      "claude",
      "--version"
    ],
    "update": [
      "npm",
      "install",
      "-g",
      "@anthropic-ai/claude-code@latest"
    ],
    "auth": {
      "cmd": [
        "claude",
        "auth",
        "status"
      ],
      "format": "json",
      "connected": "loggedIn",
      "method": "authMethod",
      "account": "email"
    },
    "mcp": {
      "cmd": [
        "claude",
        "mcp",
        "list"
      ],
      "format": "claude"
    },
    "plugins": {
      "file": "~/.claude/plugins/installed_plugins.json",
      "format": "claude-plugins"
    },
    "skills": [
      "~/.claude/skills"
    ],
    "env": [
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_AUTH_TOKEN"
    ],
    "install": {
      "unix": [
        "npm",
        "install",
        "-g",
        "@anthropic-ai/claude-code"
      ],
      "windows": [
        "npm",
        "install",
        "-g",
        "@anthropic-ai/claude-code"
      ]
    },
    "latest": {
      "npm": "@anthropic-ai/claude-code"
    },
    "requires": [
      "npm",
      "node"
    ],
    "source": "https://code.claude.com/docs/en/setup",
    "native_roots": [
      "~/.local/share/claude/versions/",
      "~/.claude/local/claude"
    ],
    "repair_paths": [
      "~/.local/share/claude/versions/*"
    ],
    "native_update": [
      "update"
    ],
    "brew_names": [
      "claude-code"
    ]
  },
  "codex": {
    "binary": "codex",
    "version": [
      "codex",
      "--version"
    ],
    "update": [
      "npm",
      "install",
      "-g",
      "@openai/codex@latest"
    ],
    "auth": {
      "cmd": [
        "codex",
        "login",
        "status"
      ],
      "format": "text"
    },
    "mcp": {
      "cmd": [
        "codex",
        "mcp",
        "list",
        "--json"
      ],
      "format": "codex"
    },
    "skills": [
      "~/.codex/skills",
      "~/.agents/skills"
    ],
    "env": [
      "OPENAI_API_KEY",
      "CODEX_API_KEY"
    ],
    "install": {
      "unix": [
        "npm",
        "install",
        "-g",
        "@openai/codex"
      ],
      "windows": [
        "npm",
        "install",
        "-g",
        "@openai/codex"
      ]
    },
    "latest": {
      "npm": "@openai/codex"
    },
    "requires": [
      "npm",
      "node"
    ],
    "source": "https://github.com/openai/codex/blob/main/README.md",
    "native_roots": [
      "~/.codex/packages/standalone/"
    ],
    "repair_paths": [
      "~/.codex/packages/standalone/current/bin/codex",
      "~/.codex/packages/standalone/releases/*/bin/codex",
      "~/.codex/packages/standalone/current/bin/codex.exe",
      "~/.codex/packages/standalone/releases/*/bin/codex.exe"
    ],
    "native_update": [
      "update"
    ],
    "brew_names": [
      "codex"
    ]
  },
  "pi": {
    "binary": "pi",
    "version": [
      "pi",
      "--version"
    ],
    "update": [
      "npm",
      "install",
      "-g",
      "@earendil-works/pi-coding-agent@latest"
    ],
    "auth": {
      "file": "~/.pi/agent/auth.json",
      "format": "keys"
    },
    "plugins": {
      "cmd": [
        "pi",
        "list"
      ],
      "format": "lines"
    },
    "skills": [
      "~/.pi/agent/skills",
      "~/.agents/skills"
    ],
    "env": [
      "ANTHROPIC_API_KEY",
      "OPENAI_API_KEY",
      "GEMINI_API_KEY",
      "OPENROUTER_API_KEY"
    ],
    "install": {
      "unix": [
        "npm",
        "install",
        "-g",
        "@earendil-works/pi-coding-agent"
      ],
      "windows": [
        "npm",
        "install",
        "-g",
        "@earendil-works/pi-coding-agent"
      ]
    },
    "latest": {
      "npm": "@earendil-works/pi-coding-agent"
    },
    "requires": [
      "npm",
      "node"
    ],
    "source": "https://github.com/badlogic/pi-mono/blob/v0.60.0/packages/coding-agent/README.md",
    "native_roots": [
      "~/.pi/bin/"
    ],
    "repair_paths": [
      "~/.pi/bin/pi"
    ],
    "native_update": [],
    "brew_names": [
      "pi",
      "pi-coding-agent"
    ]
  },
  "antigravity": {
    "binary": "agy",
    "version": [
      "agy",
      "--version"
    ],
    "update": [
      "agy",
      "update"
    ],
    "mcp": {
      "cmd": [
        "agy",
        "mcp",
        "list"
      ],
      "format": "lines"
    },
    "plugins": {
      "cmd": [
        "agy",
        "plugin",
        "list"
      ],
      "format": "lines"
    },
    "env": [
      "GEMINI_API_KEY",
      "GOOGLE_API_KEY"
    ],
    "install": {
      "unix": [
        "bash",
        "https://antigravity.google/cli/install.sh"
      ],
      "windows": [
        "powershell",
        "-ExecutionPolicy",
        "Bypass",
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "https://antigravity.google/cli/install.ps1"
      ]
    },
    "requires": [
      "bash"
    ],
    "requires_os": {
      "windows": [
        "powershell"
      ],
      "unix": [
        "bash",
        "curl"
      ]
    },
    "source": "https://antigravity.google/docs/cli/install/",
    "skills": [
      "~/.gemini/config/skills"
    ],
    "native_roots": [
      "~/.local/bin/agy",
      "~/.agy/",
      "~/.antigravity/",
      "~/AppData/Local/agy/"
    ],
    "repair_paths": [
      "~/.local/bin/agy",
      "~/.agy/bin/agy",
      "~/.antigravity/bin/agy",
      "~/AppData/Local/agy/bin/agy.exe"
    ],
    "native_update": [
      "update"
    ],
    "brew_names": [
      "antigravity",
      "agy"
    ]
  },
  "hermes": {
    "binary": "hermes",
    "version": [
      "hermes",
      "--version"
    ],
    "update": [
      "hermes",
      "update"
    ],
    "install": {
      "unix": [
        "bash",
        "https://hermes-agent.nousresearch.com/install.sh",
        "--non-interactive"
      ],
      "windows": [
        "powershell",
        "-ExecutionPolicy",
        "Bypass",
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "https://hermes-agent.nousresearch.com/install.ps1",
        "-NonInteractive"
      ]
    },
    "requires": [
      "bash"
    ],
    "requires_os": {
      "windows": [
        "powershell"
      ],
      "unix": [
        "bash",
        "curl",
        "git"
      ]
    },
    "source": "https://hermes-agent.nousresearch.com/docs/getting-started/installation",
    "latest": {
      "github": "NousResearch/hermes-agent"
    },
    "native_roots": [
      "~/.hermes/",
      "~/AppData/Local/hermes/"
    ],
    "repair_paths": [
      "~/.hermes/venv/bin/hermes",
      "~/.hermes/bin/hermes",
      "~/AppData/Local/hermes/bin/hermes.exe"
    ],
    "native_update": [
      "update"
    ],
    "brew_names": [
      "hermes-agent"
    ]
  },
  "opencode": {
    "binary": "opencode",
    "version": [
      "opencode",
      "--version"
    ],
    "install": {
      "unix": [
        "npm",
        "install",
