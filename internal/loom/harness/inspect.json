        "opencode-ai"
      ],
      "windows": [
        "npm",
        "install",
        "-g",
        "opencode-ai"
      ]
    },
    "update": [
      "opencode",
      "upgrade"
    ],
    "latest": {
      "npm": "opencode-ai"
    },
    "requires": [
      "npm",
      "node"
    ],
    "source": "https://opencode.ai/docs/",
    "native_roots": [
      "~/.opencode/bin/"
    ],
    "repair_paths": [
      "~/.opencode/bin/opencode",
      "~/.opencode/bin/opencode.exe"
    ],
    "native_update": [
      "upgrade"
    ],
    "brew_names": [
      "opencode",
      "opencode-ai"
    ]
  },
  "openclaw": {
    "binary": "openclaw",
    "version": [
      "openclaw",
      "--version"
    ],
    "install": {
      "unix": [
        "npm",
        "install",
        "-g",
        "openclaw"
      ],
      "windows": [
        "npm",
        "install",
        "-g",
        "openclaw"
      ]
    },
    "update": [
      "openclaw",
      "update"
    ],
    "latest": {
      "npm": "openclaw"
    },
    "requires": [
      "npm",
      "node"
    ],
    "source": "https://github.com/openclaw/openclaw#readme",
