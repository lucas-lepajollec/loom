      "openclaw"
    ]
  },
  "deepseek-harness": {
    "binary": "dsh",
    "version": [
      "dsh",
      "--version"
    ],
    "install": {
      "unix": [
        "npm",
        "install",
        "-g",
        "@deepseek-ai/dsh@0.2.0-rc.2"
      ],
      "windows": [
        "npm",
        "install",
        "-g",
        "@deepseek-ai/dsh@0.2.0-rc.2"
      ]
    },
    "update": [
      "npm",
      "install",
      "-g",
      "@deepseek-ai/dsh@0.2.0-rc.2"
    ],
    "requires": [
      "node",
