{
  "params": [
    {
      "id": "ctx-size",
      "label": "Context",
      "tip": "Token window. The slider goes up to the model's native limit; type a value to go beyond it.",
      "tier": "essential",
      "kind": "slider",
      "affects_vram": true,
      "requires_reload": true,
      "control": "context",
      "flag": "--ctx-size",
      "key": "CTX",
      "min": 1024,
      "step": 1024,
      "stack": true
    },
    {
      "id": "gpu-layers",
      "label": "GPU layers",
      "tip": "Number of layers offloaded to the GPU. “All” offloads every layer.",
      "tier": "essential",
      "kind": "slider",
      "affects_vram": true,
      "requires_reload": true,
      "control": "layers",
      "flag": "--gpu-layers",
      "key": "NGL",
      "min": 0,
      "step": 1,
      "stack": true,
      "covers": [
        "n-gpu-layers"
      ]
    },
    {
      "id": "reasoning",
      "label": "Reasoning",
      "tip": "The model reasons before answering if its template supports it. Turning this off sends --reasoning off.",
      "tier": "essential",
      "kind": "bool",
      "affects_vram": false,
      "requires_reload": true,
      "control": "reasoning",
      "flag": "--reasoning",
      "key": "REASONING",
      "when": "thinks"
    },
    {
      "id": "reasoning-effort",
      "label": "Effort",
      "tip": "Levels read from the model template. Blank uses the template default.",
      "tier": "essential",
      "kind": "enum",
      "affects_vram": false,
      "requires_reload": true,
      "control": "effort",
      "flag": "--reasoning-effort",
      "key": "REASONING_EFFORT",
      "when": "effort"
    },
    {
      "id": "vision",
      "label": "Vision",
      "tip": "Loads the mmproj projector found beside the model.",
      "tier": "essential",
      "kind": "bool",
      "affects_vram": true,
      "requires_reload": true,
      "control": "vision",
      "flag": "--mmproj",
      "key": "MMPROJ",
      "when": "vision",
      "covers": [
        "mmproj",
        "mmproj-auto",
        "mmproj-offload"
      ]
    },
    {
      "id": "temp",
      "label": "Temperature",
      "tip": "Sampling randomness. Blank uses the model default.",
      "tier": "essential",
      "kind": "number",
      "affects_vram": false,
      "requires_reload": true,
      "flag": "--temp",
      "key": "TEMP",
      "step": 0.05,
      "covers": [
        "temperature"
      ]
    },
    {
      "id": "sysprompt",
      "label": "System prompt",
      "tip": "Specific to this model or preset. Blank uses the prompt from Settings.",
      "tier": "essential",
      "kind": "textarea",
      "affects_vram": false,
      "requires_reload": true,
      "key": "SYSPROMPT",
      "stack": true,
      "placeholder": "Blank = prompt from Settings"
    },
    {
      "id": "kv",
      "label": "KV cache",
      "tip": "Context cache compression. f16 gives maximum quality; q8/q4 reduce VRAM use.",
      "tier": "advanced",
      "kind": "enum",
      "affects_vram": true,
      "requires_reload": true,
      "control": "kv",
      "choices": [
        [
          "",
          "f16"
        ],
        [
          "q8_0|q8_0",
          "q8_0"
        ],
        [
          "q5_1|q5_1",
          "q5_1"
        ],
        [
          "q4_0|q4_0",
          "q4_0"
        ],
        [
          "q8_0|q5_1",
          "q8_0 / q5_1"
        ],
        [
          "q8_0|q5_0",
          "q8_0 / q5_0"
        ]
      ],
      "covers": [
        "cache-type-k",
        "cache-type-v"
      ]
    },
    {
      "id": "parallel",
      "label": "Parallel slots",
      "tip": "Requests handled simultaneously by llama.cpp (continuous batching).",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": true,
      "requires_reload": true,
      "control": "parallel",
      "flag": "--parallel",
      "key": "NP",
      "step": 1,
      "placeholder": "4"
    },
    {
      "id": "spec-type",
      "label": "Speculative decoding",
      "tip": "Predicts tokens (MTP, EAGLE, n-grams) to speed up generation.",
      "tier": "advanced",
      "kind": "enum",
      "affects_vram": true,
      "requires_reload": true,
      "flag": "--spec-type",
      "choices": [
        [
          "",
          "no"
        ],
        [
          "draft-mtp",
          "MTP"
        ],
        [
          "draft-eagle3",
          "EAGLE-3"
        ],
        [
          "draft-simple",
          "Draft model"
        ],
        [
          "ngram-simple",
          "n-grams"
        ]
      ]
    },
    {
      "id": "flash-attn",
      "label": "Flash attention",
      "tip": "Faster and more memory efficient. Auto lets llama.cpp decide.",
      "tier": "advanced",
      "kind": "enum",
      "affects_vram": true,
      "requires_reload": true,
      "flag": "--flash-attn",
      "requires_flag": true,
      "choices": [
        [
          "",
          "auto"
        ],
        [
          "on",
          "on"
        ],
        [
          "off",
          "off"
        ]
      ]
    },
    {
      "id": "fit",
      "key": "FIT",
      "label": "Fit to VRAM",
      "tip": "Lets llama.cpp reduce unset parameters to fit in memory.",
      "tier": "advanced",
      "kind": "bool",
      "affects_vram": true,
      "requires_reload": true,
      "control": "fit",
      "flag": "--fit",
      "requires_flag": true
    },
    {
      "id": "batch-size",
      "label": "Batch",
      "tip": "Logical batch size for prompts. Larger is faster but uses more VRAM.",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": true,
      "requires_reload": true,
      "flag": "--batch-size",
      "requires_flag": true,
      "step": 1
    },
    {
      "id": "ubatch-size",
      "label": "Micro-batch",
      "tip": "Physical micro-batch size. 512 is a good starting point.",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": true,
      "requires_reload": true,
      "flag": "--ubatch-size",
      "requires_flag": true,
      "step": 1
    },
    {
      "id": "threads",
      "label": "CPU threads",
      "tip": "0 = automatic.",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": false,
      "requires_reload": true,
      "flag": "--threads",
      "requires_flag": true,
      "step": 1
    },
    {
      "id": "threads-batch",
      "label": "Threads (prompt)",
      "tip": "0 = same as CPU threads.",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": false,
      "requires_reload": true,
      "flag": "--threads-batch",
      "requires_flag": true,
      "step": 1
    },
    {
      "id": "n-cpu-moe",
      "label": "MoE experts on CPU",
      "tip": "Keeps the first N expert layers on the CPU.",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": true,
      "requires_reload": true,
      "flag": "--n-cpu-moe",
      "requires_flag": true,
      "step": 1
    },
    {
      "id": "top-p",
      "label": "top_p",
      "tip": "1 = disabled.",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": false,
      "requires_reload": true,
      "flag": "--top-p",
      "requires_flag": true,
      "step": 1
    },
    {
      "id": "top-k",
      "label": "top_k",
      "tip": "0 = disabled.",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": false,
      "requires_reload": true,
      "flag": "--top-k",
      "requires_flag": true,
      "step": 1
    },
    {
      "id": "min-p",
      "label": "min_p",
      "tip": "0 = disabled.",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": false,
      "requires_reload": true,
      "flag": "--min-p",
      "requires_flag": true,
      "step": 1
    },
    {
      "id": "repeat-penalty",
      "label": "Repetition penalty",
      "tip": "1 = neutral.",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": false,
      "requires_reload": true,
      "flag": "--repeat-penalty",
      "requires_flag": true,
      "step": 1
    },
    {
      "id": "presence-penalty",
      "label": "Presence penalty",
      "tip": "0 = neutral.",
      "tier": "advanced",
      "kind": "number",
      "affects_vram": false,
      "requires_reload": true,
      "flag": "--presence-penalty",
      "requires_flag": true,
      "step": 1
    }
  ],
  "expert_excludes": [
    "load-mode",
    "mlock",
    "mmap",
    "kv-unified",
    "jinja",
    "spec-draft-n-max",
    "model-draft"
  ]
}
